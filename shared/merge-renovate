#!/usr/bin/env bash

set -e

# Space-separated substrings; branches whose name contains any of them are
# skipped, e.g.:
#   RENOVATE_IGNORE="aws ansible" make merge-renovate
read -ra ignore <<< "${RENOVATE_IGNORE:-}"

git checkout main
git pull github

git branch \
	--remotes \
	--sort authordate \
	--list 'github/renovate/*' | \
cut -d / -f 2- | \
while read -r br; do
	skip=0
	for pattern in "${ignore[@]}"; do
		if [[ $br == *"$pattern"* ]]; then
			skip=1
			break
		fi
	done
	if ((skip)); then
		echo "Skipping $br"
		continue
	fi

	git checkout "$br"
	git rebase main
	git push --force-with-lease
	git checkout main
	git merge --ff-only "$br"
	git push
	git push --delete github "$br"
	git branch --delete "$br"
done
